{
  "name": "sentry-neko",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "tsc --noEmit && node scripts/check_locales.mjs",
    "test:numeric-input": "playwright test",
    "icons": "tauri icon src-tauri/app-icon.svg",
    "tauri": "tauri",
    "test": "tsc --ignoreConfig --target es2022 --module esnext --skipLibCheck --outDir .cache/sidebar-test src/types/sidebar.ts && node --test scripts/*.test.mjs",
    "test:sidebar": "tsc --ignoreConfig --target es2022 --module esnext --skipLibCheck --outDir .cache/sidebar-test src/types/sidebar.ts && node --test scripts/sidebar.test.mjs",
    "test:ui": "playwright test"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@tauri-apps/api": "^2.12.4",
    "i18next": "^26.4.7",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.0.19",
    "react-router-dom": "^7.18.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tauri-apps/cli": "^2.12.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
